@model DTO.DataAccess.DataAccess.DTO.InvoiceEntity
@{
    ViewData["Title"] = "Invoice details";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Invoice details</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>Edit</a>
    </div>
</header>

<div class="section medium">
    <dl class="card details">
    <div class="details__row"><dt>Date</dt><dd>@Model.InvoiceDate</dd></div>
    <div class="details__row"><dt>Address</dt><dd><div class="stack-cell"><span>@Model.Address.Name</span><span>@Model.Address.FullAddress</span></div></dd></div>
    <div class="details__row"><dt>Service</dt><dd>@Model.Service.Name</dd></div>
    <div class="details__row"><dt>Total</dt><dd>@Model.TotalSum €</dd></div>
</dl>
    <div><a asp-action="Index" class="btn btn--ghost">Back to invoices</a></div>
</div>
