@model IEnumerable<DTO.DataAccess.DataAccess.DTO.InvoiceEntity>
@{
    ViewData["Title"] = "Invoices";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Invoices</h1>
    </div>
    <div class="page-header__actions">
        <a asp-controller="InvoiceImports" asp-action="Upload" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-upload"></use></svg>Import PDF</a>
        <a asp-action="Create" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Create invoice</a>
    </div>
</header>

<div class="card table-card">
    <table class="data-table">
        <thead><tr><th>Date</th><th>Address</th><th>Service</th><th class="num">Total</th><th class="actions-col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="nowrap">@item.InvoiceDate</td>
                <td><div class="stack-cell"><span>@item.Address.Name</span><span>@item.Address.FullAddress</span></div></td>
                <td>@item.Service.Name</td>
                <td class="num">@item.TotalSum €</td>
                <td class="actions-col"><div class="row-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn" aria-label="Details" title="Details"><svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" aria-label="Edit" title="Edit"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn icon-btn--danger" aria-label="Delete" title="Delete"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></a>
                </div></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="empty">No invoices yet. Create one or import a provider PDF.</td></tr>
        }
        </tbody>
    </table>
</div>
