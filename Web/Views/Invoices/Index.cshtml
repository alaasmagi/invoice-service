@model InvoicesIndexViewModel
@{
    ViewData["Title"] = T["Invoices"];
    var groups = Model.Invoices
        .GroupBy(e => BillingPeriod.From(e.InvoiceDate))
        .OrderByDescending(g => g.Key)
        .ToList();
    var showGroups = Model.Period == null && groups.Count > 1;
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Billing"]</p>
        <h1>@T["Invoices"]</h1>
    </div>
    <div class="page-header__actions">
        <a asp-controller="InvoiceImports" asp-action="Upload" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-upload"></use></svg>@T["Import PDF"]</a>
        <a asp-action="Create" asp-route-addressId="@Model.AddressId" asp-route-serviceId="@Model.ServiceId" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>@T["Add invoice"]</a>
    </div>
</header>

<form method="get" asp-action="Index" class="card filter-bar" role="search" aria-label="@T["Filter invoices"]">
    <div class="field">
        <label for="filterPeriod" class="field__label">@T["Month"]</label>
        <div class="field__control">
            <select id="filterPeriod" name="period" class="input" data-autosubmit>
                <option value="">@T["All months"]</option>
                @foreach (var option in Model.PeriodOptions)
                {
                    <option value="@option.Key" selected="@(option.Key == Model.Period)">@option.Label</option>
                }
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
    </div>
    <div class="field">
        <label for="filterAddress" class="field__label">@T["Address"]</label>
        <div class="field__control">
            <select id="filterAddress" name="addressId" class="input" asp-items="Model.AddressOptions" data-autosubmit>
                <option value="">@T["All addresses"]</option>
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
    </div>
    <div class="field">
        <label for="filterService" class="field__label">@T["Service"]</label>
        <div class="field__control">
            <select id="filterService" name="serviceId" class="input" asp-items="Model.ServiceOptions" data-autosubmit>
                <option value="">@T["All services"]</option>
            </select>
            <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
        </div>
    </div>
    <noscript><button type="submit" class="btn btn--secondary">@T["Apply"]</button></noscript>
    @if (Model.IsFiltered)
    {
        <a asp-action="Index" class="btn btn--ghost btn--sm filter-bar__reset">@T["Clear filters"]</a>
    }
</form>

<div class="card table-card">
    <table class="data-table">
        <thead><tr><th>@T["Invoice date"]</th><th>@T["Address"]</th><th>@T["Service"]</th><th>@T["Billed period"]</th><th class="num">@T["Total"]</th><th class="actions-col"><span class="visually-hidden">@T["Actions"]</span></th></tr></thead>
        <tbody>
        @foreach (var group in groups)
        {
            if (showGroups)
            {
                <tr class="group-row"><td colspan="4">@group.Key.Label · @T.Plural(group.Count(), "{0} invoice", "{0} invoices")</td><td class="num">@Fmt.Money(group.Sum(e => e.TotalSum))</td><td></td></tr>
            }
            foreach (var item in group)
            {
                <tr>
                    <td class="nowrap"><a asp-action="Details" asp-route-id="@item.Id" class="link">@Fmt.Date(item.InvoiceDate)</a></td>
                    <td><div class="stack-cell"><span>@item.Address.Name</span><span>@item.Address.FullAddress</span></div></td>
                    <td>@item.Service.Name</td>
                    <td class="nowrap secondary">@Fmt.Range(item.PeriodStart, item.PeriodEnd)</td>
                    <td class="num">@Fmt.Money(item.TotalSum)</td>
                    <td class="actions-col"><div class="row-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" aria-label="@T["Edit"]" title="@T["Edit"]"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn icon-btn--danger" aria-label="@T["Delete"]" title="@T["Delete"]"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></a>
                    </div></td>
                </tr>
            }
        }
        @if (!Model.Invoices.Any())
        {
            <tr><td colspan="6" class="empty">
                @if (Model.IsFiltered)
                {
                    <span>@T["No invoices match these filters."] <a asp-action="Index" class="link">@T["Clear filters"]</a></span>
                }
                else
                {
                    <span>@T["No invoices yet."] <a asp-action="Create" class="link">@T["Add one manually"]</a> @T["or"] <a asp-controller="InvoiceImports" asp-action="Upload" class="link">@T["import a provider PDF"]</a>.</span>
                }
            </td></tr>
        }
        </tbody>
        @if (Model.Invoices.Any())
        {
            <tfoot><tr><td colspan="4">@T.Plural(Model.Invoices.Count, "{0} invoice", "{0} invoices")</td><td class="num">@Fmt.Money(Model.Invoices.Sum(e => e.TotalSum))</td><td></td></tr></tfoot>
        }
    </table>
</div>
