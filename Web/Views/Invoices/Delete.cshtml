@model DTO.DataAccess.DataAccess.DTO.InvoiceEntity
@{
    ViewData["Title"] = "Delete invoice";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Delete invoice</h1>
    </div>
</header>

<div class="section medium">
    <div class="alert alert--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
        <div class="alert__body"><span class="alert__title">Delete this invoice?</span><span>This action cannot be undone.</span></div>
    </div>
    <dl class="card details">
    <div class="details__row"><dt>Date</dt><dd>@Model.InvoiceDate</dd></div>
    <div class="details__row"><dt>Address</dt><dd><div class="stack-cell"><span>@Model.Address.Name</span><span>@Model.Address.FullAddress</span></div></dd></div>
    <div class="details__row"><dt>Service</dt><dd>@Model.Service.Name</dd></div>
    <div class="details__row"><dt>Total</dt><dd>@Model.TotalSum €</dd></div>
</dl>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn--danger">Delete invoice</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </form>
</div>
