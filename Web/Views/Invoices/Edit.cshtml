@model InvoiceDto
@{
    ViewData["Title"] = T["Edit invoice"];
    var form = ViewData["Form"] as InvoiceFormViewModel ?? new InvoiceFormViewModel();
    var sent = form.IncludedInStatements.Count(e => e.Status == Domain.EMonthlyStatementStatus.Sent);
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Billing"]</p>
        <h1>@T["Edit invoice"]</h1>
    </div>
</header>

@if (form.IncludedInStatements.Any())
{
    <div class="alert alert--warning narrow">
        <svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
        <div class="alert__body">
            <span class="alert__title">@(sent > 0 ? T["This invoice is already part of {0} statement(s), {1} of them sent.", form.IncludedInStatements.Count, sent] : T.Plural(form.IncludedInStatements.Count, "This invoice is already part of {0} statement.", "This invoice is already part of {0} statements."))</span>
            <span>@(sent > 0 ? T["Saving won't change those statements. Regenerate the period afterwards so the amounts are updated, and let recipients know if a sent statement changes."] : T["Saving won't change those statements. Regenerate the period afterwards so the amounts are updated."])</span>
        </div>
    </div>
}

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <partial name="_InvoiceFields" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save changes"]</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
