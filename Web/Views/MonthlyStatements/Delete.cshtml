@model DTO.DataAccess.DataAccess.DTO.MonthlyStatementEntity
@{
    ViewData["Title"] = "Delete statement";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Delete statement</h1>
    </div>
</header>

<div class="section medium">
    <div class="alert alert--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
        <div class="alert__body"><span class="alert__title">Delete this statement?</span><span>This action cannot be undone.</span></div>
    </div>
    <dl class="card details">
    <div class="details__row"><dt>Person</dt><dd>@Model.Contact.FullName</dd></div>
    <div class="details__row"><dt>Period</dt><dd>@Model.Period</dd></div>
    <div class="details__row"><dt>Total</dt><dd>@Model.TotalSum €</dd></div>
    <div class="details__row"><dt>Status</dt><dd><partial name="_StatementStatus" model="Model.Status" /></dd></div>
</dl>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn--danger">Delete statement</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </form>
</div>
