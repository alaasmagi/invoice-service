@model DTO.DataAccess.DataAccess.DTO.MonthlyStatementEntity
@{
    ViewData["Title"] = "Generate statements";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Generate statements</h1>
        <p class="page-header__lede">Generates one statement per person for the selected month across all addresses and invoices.</p>
    </div>
</header>

<form asp-action="Generate" method="post" class="card form narrow">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-row">
        <div class="field">
            <label asp-for="Year" class="field__label"></label>
            <input asp-for="Year" class="input" placeholder="e.g. 2026" />
            <span asp-validation-for="Year"></span>
        </div>
        <div class="field">
            <label asp-for="Month" class="field__label"></label>
            <div class="field__control"><select asp-for="Month" class="input" asp-items="Enumerable.Range(1, 12).Select(m => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m), m.ToString()))"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="Month"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Generate statements</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
