@model Web.Models.MonthlyStatementDetailViewModel
@{
    var statement = Model.Statement;
    var period = new BillingPeriod(statement.Year, statement.Month);
    var isSent = statement.Status == Domain.EMonthlyStatementStatus.Sent;
    ViewData["Title"] = $"{statement.Contact.FullName} · {period.Label}";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Monthly statement"] · @period.Label</p>
        <h1>@statement.Contact.FullName</h1>
        <p class="page-header__lede">@Fmt.Money(statement.TotalSum) · <partial name="_StatementStatus" model="statement.Status" /></p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@statement.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>@T["Edit"]</a>
        @if (Model.CanSend)
        {
            <form asp-action="Send" asp-route-id="@statement.Id" method="post"
                  data-confirm="@(T["Email this statement ({0}) to {1} <{2}>?", Fmt.Money(statement.TotalSum), statement.Contact.FullName, statement.Contact.Email] + (isSent ? " " + T["It was already sent once."] : ""))"
                  data-confirm-title="@(isSent ? T["Send again?"] : T["Send statement?"])" data-confirm-action="@(isSent ? T["Send again"] : T["Send"])">
                <button type="submit" class="btn btn--primary">
                    <svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg>@(isSent ? T["Send again"] : T["Send"])
                </button>
            </form>
        }
    </div>
</header>

<dl class="card details medium">
    <div class="details__row"><dt>@T["Person"]</dt><dd><div class="stack-cell"><a asp-controller="Contacts" asp-action="Details" asp-route-id="@statement.ContactId" class="link">@statement.Contact.FullName</a><span>@statement.Contact.Email</span></div></dd></div>
    <div class="details__row"><dt>@T["Month"]</dt><dd><a asp-action="Index" asp-route-period="@period.Key" class="link">@period.Label</a></dd></div>
    <div class="details__row"><dt>@T["Addresses"]</dt><dd>@(Model.AddressNames.Any() ? string.Join(", ", Model.AddressNames) : "—")</dd></div>
    <div class="details__row"><dt>@T["Total"]</dt><dd><strong>@Fmt.Money(statement.TotalSum)</strong></dd></div>
    <div class="details__row"><dt>@T["Status"]</dt><dd><partial name="_StatementStatus" model="statement.Status" /></dd></div>
    <div class="details__row"><dt>@T["Sent at"]</dt><dd>@Fmt.Timestamp(statement.SentAt, T["Not sent yet"])</dd></div>
</dl>

<section class="section">
    <h2 class="section-title">@T["Invoice shares"]</h2>
    <div class="card table-card">
        <table class="data-table">
            <thead><tr><th>@T["Address"]</th><th>@T["Service"]</th><th>@T["Invoice date"]</th><th>@T["Billed period"]</th><th class="num">@T["Invoice total"]</th><th class="num">@T["Split"]</th><th class="num">@T["Share"]</th></tr></thead>
            <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.AddressName</td>
                    <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@line.InvoiceId" class="link">@line.ServiceName</a></td>
                    <td class="nowrap">@Fmt.Date(line.InvoiceDate)</td>
                    <td class="nowrap secondary">@Fmt.Range(line.PeriodStart, line.PeriodEnd)</td>
                    <td class="num">@Fmt.Money(line.InvoiceTotal)</td>
                    <td class="num">@Fmt.SplitLabel(line.AllocationMethod, line.ShareValue, line.ResidentCount)</td>
                    <td class="num"><strong>@Fmt.Money(line.AllocatedAmount)</strong></td>
                </tr>
            }
            @if (!Model.Lines.Any())
            {
                <tr><td colspan="7" class="empty">@T["This statement has no invoice lines. It was probably created manually."]</td></tr>
            }
            </tbody>
            @if (Model.Lines.Any())
            {
                <tfoot><tr><td colspan="6">@T["Total"]</td><td class="num">@Fmt.Money(Model.Lines.Sum(e => e.AllocatedAmount))</td></tr></tfoot>
            }
        </table>
    </div>
</section>

<div class="actions">
    <a asp-action="Index" asp-route-period="@period.Key" class="btn btn--ghost">@T["Back to {0} statements", period.Label]</a>
</div>
