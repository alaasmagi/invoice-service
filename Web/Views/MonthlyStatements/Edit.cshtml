@model MonthlyStatementDto
@{
    ViewData["Title"] = T["Edit statement"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Billing"]</p>
        <h1>@T["Edit statement"]</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="ContactId" class="field__label"></label>
        <div class="field__control"><select asp-for="ContactId" class="input" asp-items="ViewBag.ContactId"><option value="">@T["Select person…"]</option></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
        <span asp-validation-for="ContactId"></span>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="Year" class="field__label"></label>
            <input asp-for="Year" class="input" type="number" min="2000" max="2100" placeholder="@T["e.g. 2026"]" />
            <span asp-validation-for="Year"></span>
        </div>
        <div class="field">
            <label asp-for="Month" class="field__label"></label>
            <div class="field__control"><select asp-for="Month" class="input" asp-items="Fmt.MonthOptions()"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="Month"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="TotalSum" class="field__label"></label>
            <input asp-for="TotalSum" class="input" type="number" step="0.01" value="@Formatter.InputNumber(Model.TotalSum)" placeholder="@T["e.g. 76.08"]" />
            <span asp-validation-for="TotalSum"></span>
        </div>
        <div class="field">
            <label asp-for="Status" class="field__label"></label>
            <div class="field__control"><select asp-for="Status" class="input" asp-items="Fmt.StatusOptions()"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="Status"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save changes"]</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
