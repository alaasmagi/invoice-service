@model DTO.DataAccess.DataAccess.DTO.MonthlyStatementEntity
@{
    ViewData["Title"] = "Edit statement";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Edit statement</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="ContactId" class="field__label"></label>
        <div class="field__control"><select asp-for="ContactId" class="input" asp-items="ViewBag.ContactId"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
        <span asp-validation-for="ContactId"></span>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="Year" class="field__label"></label>
            <input asp-for="Year" class="input" placeholder="e.g. 2026" />
            <span asp-validation-for="Year"></span>
        </div>
        <div class="field">
            <label asp-for="Month" class="field__label"></label>
            <div class="field__control"><select asp-for="Month" class="input" asp-items="Enumerable.Range(1, 12).Select(m => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m), m.ToString()))"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="Month"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="TotalSum" class="field__label"></label>
            <input asp-for="TotalSum" class="input" type="number" step="0.01" placeholder="e.g. 76.08" />
            <span asp-validation-for="TotalSum"></span>
        </div>
        <div class="field">
            <label asp-for="Status" class="field__label"></label>
            <div class="field__control"><select asp-for="Status" class="input" asp-items="Html.GetEnumSelectList<Domain.EMonthlyStatementStatus>()"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="Status"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Save</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
