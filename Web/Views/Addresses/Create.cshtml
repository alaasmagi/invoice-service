@model AddressDto
@{
    ViewData["Title"] = T["Add address"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Add address"]</h1>
    </div>
</header>

<form asp-action="Create" method="post" class="card form narrow">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="Name" class="field__label"></label>
        <input asp-for="Name" class="input" placeholder="@T["e.g. City centre flat"]" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="field">
        <label asp-for="FullAddress" class="field__label"></label>
        <input asp-for="FullAddress" class="input" placeholder="@T["e.g. Narva mnt 7-21, Tallinn"]" />
        <span asp-validation-for="FullAddress"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save address"]</button>
        <a href="@Url.LocalOr(ViewData["ReturnUrl"] as string, Url.Action("Index"))" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
