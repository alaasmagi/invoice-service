@model AddressDetailsViewModel
@{
    ViewData["Title"] = Model.Address.Name;
    var address = Model.Address;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var here = Context.Request.Path.ToString();
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Address</p>
        <h1>@address.Name</h1>
        <p class="page-header__lede">@address.FullAddress</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@address.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>Edit</a>
        <a asp-action="Delete" asp-route-id="@address.Id" class="btn btn--ghost"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>Delete</a>
    </div>
</header>

<section class="section medium">
    <div class="section-head">
        <h2 class="section-title">Residents</h2>
        <a asp-controller="AddressContacts" asp-action="Create" asp-route-addressId="@address.Id" asp-route-returnUrl="@here" class="btn btn--secondary btn--sm"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Add resident</a>
    </div>
    <p class="secondary">Invoices for this address are split equally between the people living here on the invoice date.</p>
    <div class="card table-card">
        <table class="data-table">
            <thead><tr><th>Person</th><th>Moved in</th><th>Moved out</th><th class="actions-col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var resident in Model.Residents)
            {
                var current = resident.IsActive(today);
                <tr>
                    <td><div class="stack-cell"><a asp-controller="Contacts" asp-action="Details" asp-route-id="@resident.ContactId" class="link">@resident.Contact.FullName</a><span>@resident.Contact.Email</span></div></td>
                    <td class="nowrap">@Fmt.Date(resident.StartDate)</td>
                    <td class="nowrap">@if (resident.EndDate == null) { <span class="badge badge--success">Lives here</span> } else { <span class="@(current ? null : "secondary")">@Fmt.Date(resident.EndDate)</span> }</td>
                    <td class="actions-col"><div class="row-actions">
                        <a asp-controller="AddressContacts" asp-action="Edit" asp-route-id="@resident.Id" asp-route-returnUrl="@here" class="btn btn--ghost btn--sm">@(resident.EndDate == null ? "Set move-out" : "Edit")</a>
                    </div></td>
                </tr>
            }
            @if (!Model.Residents.Any())
            {
                <tr><td colspan="4" class="empty">Nobody lives here yet, so invoices for this address can't be billed. <a asp-controller="AddressContacts" asp-action="Create" asp-route-addressId="@address.Id" asp-route-returnUrl="@here" class="link">Add a resident</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="section medium">
    <div class="section-head">
        <h2 class="section-title">Recent invoices</h2>
        <div class="actions">
            @if (Model.InvoiceCount > Model.RecentInvoices.Count)
            {
                <a asp-controller="Invoices" asp-action="Index" asp-route-addressId="@address.Id" class="btn btn--ghost btn--sm">All @Model.InvoiceCount invoices</a>
            }
            <a asp-controller="Invoices" asp-action="Create" asp-route-addressId="@address.Id" class="btn btn--secondary btn--sm"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Add invoice</a>
        </div>
    </div>
    <div class="card table-card">
        <table class="data-table">
            <thead><tr><th>Date</th><th>Service</th><th>Billed period</th><th class="num">Total</th></tr></thead>
            <tbody>
            @foreach (var invoice in Model.RecentInvoices)
            {
                <tr>
                    <td class="nowrap"><a asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.Id" class="link">@Fmt.Date(invoice.InvoiceDate)</a></td>
                    <td>@invoice.Service.Name</td>
                    <td class="nowrap secondary">@Fmt.Range(invoice.PeriodStart, invoice.PeriodEnd)</td>
                    <td class="num">@Fmt.Money(invoice.TotalSum)</td>
                </tr>
            }
            @if (!Model.RecentInvoices.Any())
            {
                <tr><td colspan="4" class="empty">No invoices for this address yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="actions">
    <a asp-action="Index" class="btn btn--ghost">Back to addresses</a>
</div>
