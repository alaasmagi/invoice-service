@model DTO.DataAccess.DataAccess.DTO.AddressEntity
@{
    ViewData["Title"] = "Address details";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Directory</p>
        <h1>Address details</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>Edit</a>
    </div>
</header>

<div class="section medium">
    <dl class="card details">
    <div class="details__row"><dt>Name</dt><dd>@Model.Name</dd></div>
    <div class="details__row"><dt>Full address</dt><dd>@Model.FullAddress</dd></div>
</dl>
    <div><a asp-action="Index" class="btn btn--ghost">Back to addresses</a></div>
</div>
