@model DeleteViewModel<AddressDto>
@{
    ViewData["Title"] = T["Delete address"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Delete address"]</h1>
    </div>
</header>

<div class="section medium">
    <partial name="_DeleteNotice" model='Model.Notice(T["address"])' />
    <dl class="card details">
        <div class="details__row"><dt>@T["Name"]</dt><dd>@Model.Item.Name</dd></div>
        <div class="details__row"><dt>@T["Full address"]</dt><dd>@Model.Item.FullAddress</dd></div>
    </dl>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" name="Id" value="@Model.Item.Id" />
        @if (!Model.Blockers.Any())
        {
            <button type="submit" class="btn btn--danger">@T["Delete address"]</button>
        }
        <a asp-action="Details" asp-route-id="@Model.Item.Id" class="btn btn--ghost">@T["Cancel"]</a>
    </form>
</div>
