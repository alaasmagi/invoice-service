@model DTO.DataAccess.DataAccess.DTO.ContactEntity
@{
    ViewData["Title"] = "Create contact";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Directory</p>
        <h1>Create contact</h1>
    </div>
</header>

<form asp-action="Create" method="post" class="card form narrow">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="FullName" class="field__label"></label>
        <input asp-for="FullName" class="input" placeholder="e.g. Andres Tamm" />
        <span asp-validation-for="FullName"></span>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" placeholder="e.g. andres.tamm@gmail.com" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="field">
            <label asp-for="Phone" class="field__label"></label>
            <input asp-for="Phone" class="input" placeholder="e.g. +372 5123 4567" />
            <span asp-validation-for="Phone"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Create contact</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
