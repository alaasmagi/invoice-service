@model ContactDto
@{
    ViewData["Title"] = T["Add contact"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Add contact"]</h1>
    </div>
</header>

<form asp-action="Create" method="post" class="card form narrow">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="FullName" class="field__label"></label>
        <input asp-for="FullName" class="input" placeholder="@T["e.g. Andres Tamm"]" />
        <span asp-validation-for="FullName"></span>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" type="email" autocomplete="off" placeholder="e.g. andres.tamm@gmail.com" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="field">
            <label asp-for="Phone" class="field__label"></label>
            <input asp-for="Phone" class="input" type="tel" placeholder="@T["e.g. +372 5123 4567"]" />
            <span asp-validation-for="Phone"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save contact"]</button>
        <button type="submit" name="next" value="another" class="btn btn--secondary">@T["Save and add another"]</button>
        <a href="@Url.LocalOr(ViewData["ReturnUrl"] as string, Url.Action("Index"))" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
