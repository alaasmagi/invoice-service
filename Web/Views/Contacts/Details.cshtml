@model DTO.DataAccess.DataAccess.DTO.ContactEntity
@{
    ViewData["Title"] = "Contact details";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Directory</p>
        <h1>Contact details</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>Edit</a>
    </div>
</header>

<div class="section medium">
    <dl class="card details">
    <div class="details__row"><dt>Name</dt><dd>@Model.FullName</dd></div>
    <div class="details__row"><dt>Email</dt><dd>@Model.Email</dd></div>
    <div class="details__row"><dt>Phone</dt><dd>@Model.Phone</dd></div>
</dl>
    <div><a asp-action="Index" class="btn btn--ghost">Back to contacts</a></div>
</div>
