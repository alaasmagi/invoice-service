@model ContactDetailsViewModel
@{
    var contact = Model.Contact;
    ViewData["Title"] = contact.FullName;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var here = Context.Request.Path.ToString();
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Contact</p>
        <h1>@contact.FullName</h1>
        <p class="page-header__lede">@contact.Email@(string.IsNullOrEmpty(contact.Phone) ? "" : $" · {contact.Phone}")</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@contact.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>Edit</a>
        <a asp-action="Delete" asp-route-id="@contact.Id" class="btn btn--ghost"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>Delete</a>
    </div>
</header>

<section class="section medium">
    <div class="section-head">
        <h2 class="section-title">Lives at</h2>
        <a asp-controller="AddressContacts" asp-action="Create" asp-route-contactId="@contact.Id" asp-route-returnUrl="@here" class="btn btn--secondary btn--sm"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Add to address</a>
    </div>
    <div class="card table-card">
        <table class="data-table">
            <thead><tr><th>Address</th><th>Moved in</th><th>Moved out</th><th class="actions-col"><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
            @foreach (var residency in Model.Residencies)
            {
                <tr>
                    <td><div class="stack-cell"><a asp-controller="Addresses" asp-action="Details" asp-route-id="@residency.AddressId" class="link">@residency.Address.Name</a><span>@residency.Address.FullAddress</span></div></td>
                    <td class="nowrap">@Fmt.Date(residency.StartDate)</td>
                    <td class="nowrap">@if (residency.EndDate == null) { <span class="badge badge--success">Lives here</span> } else { <span class="@(residency.IsActive(today) ? null : "secondary")">@Fmt.Date(residency.EndDate)</span> }</td>
                    <td class="actions-col"><a asp-controller="AddressContacts" asp-action="Edit" asp-route-id="@residency.Id" asp-route-returnUrl="@here" class="btn btn--ghost btn--sm">@(residency.EndDate == null ? "Set move-out" : "Edit")</a></td>
                </tr>
            }
            @if (!Model.Residencies.Any())
            {
                <tr><td colspan="4" class="empty">Not linked to any address, so @contact.FullName won't get statements. <a asp-controller="AddressContacts" asp-action="Create" asp-route-contactId="@contact.Id" asp-route-returnUrl="@here" class="link">Add to an address</a>.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="section medium">
    <h2 class="section-title">Recent statements</h2>
    <div class="card table-card">
        <table class="data-table">
            <thead><tr><th>Month</th><th>Status</th><th>Sent at</th><th class="num">Total</th></tr></thead>
            <tbody>
            @foreach (var statement in Model.Statements)
            {
                <tr>
                    <td class="nowrap"><a asp-controller="MonthlyStatements" asp-action="Details" asp-route-id="@statement.Id" class="link">@(new BillingPeriod(statement.Year, statement.Month).Label)</a></td>
                    <td><partial name="_StatementStatus" model="statement.Status" /></td>
                    <td class="nowrap secondary">@Fmt.Timestamp(statement.SentAt)</td>
                    <td class="num">@Fmt.Money(statement.TotalSum)</td>
                </tr>
            }
            @if (!Model.Statements.Any())
            {
                <tr><td colspan="4" class="empty">No statements yet.</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<div class="actions">
    <a asp-action="Index" class="btn btn--ghost">Back to contacts</a>
</div>
