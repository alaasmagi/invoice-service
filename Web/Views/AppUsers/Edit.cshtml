@model Web.Models.AppUserEditViewModel
@{
    ViewData["Title"] = "User information";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Account</p>
        <h1>User information</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Username" />

    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-row">
        <div class="field">
            <label asp-for="Email" class="field__label"></label>
            <input asp-for="Email" class="input" disabled />
        </div>
        <div class="field">
            <label asp-for="Username" class="field__label"></label>
            <input asp-for="Username" class="input" disabled />
        </div>
    </div>

    <div class="field">
        <label asp-for="FullName" class="field__label"></label>
        <input asp-for="FullName" class="input" autocomplete="name" />
        <span asp-validation-for="FullName"></span>
    </div>

    <div class="form-row">
        <div class="field">
            <label asp-for="Locale" class="field__label"></label>
            <input asp-for="Locale" class="input" autocomplete="language" placeholder="e.g. et-EE" />
            <span asp-validation-for="Locale"></span>
        </div>
        <div class="field">
            <label asp-for="BankIban" class="field__label"></label>
            <input asp-for="BankIban" class="input mono" autocomplete="off" placeholder="e.g. EE38 2200 2210 2014 5685" />
            <span asp-validation-for="BankIban"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Save</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn--ghost">Back</a>
    </div>
</form>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
