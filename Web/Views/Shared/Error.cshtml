@model ErrorViewModel
@{
    ViewData["Title"] = T["Error"];
}

<section class="card prose medium">
    <p class="kicker">@T["Runtime"]</p>
    <h1>@T["Error"]</h1>
    <div class="alert alert--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-circle-x"></use></svg>
        <div class="alert__body">@T["An error occurred while processing your request."]</div>
    </div>

    @if (Model.ShowRequestId)
    {
        <div class="request-id">@T["Request ID"] <code class="code-chip">@Model.RequestId</code></div>
    }

    <h2>@T["Development mode"]</h2>
    <p>@T["Swapping to"] <strong>@T["Development"]</strong> @T["environment will display more detailed information about the error that occurred."]</p>
    <div class="alert alert--warning">
        <svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
        <div class="alert__body">
            <span class="alert__title">@T["The Development environment shouldn't be enabled for deployed applications."]</span>
            <span>@T["It can result in displaying sensitive information from exceptions to end users. For local debugging, enable the"] <strong>@T["Development"]</strong> @T["environment by setting the"] <strong>@T["ASPNETCORE_ENVIRONMENT"]</strong> @T["environment variable to"] <strong>@T["Development"]</strong> @T["and restarting the app."]</span>
        </div>
    </div>
</section>
