@model Domain.EMonthlyStatementStatus
@{
    var tone = Model switch
    {
        Domain.EMonthlyStatementStatus.ReadyToSend => "accent",
        Domain.EMonthlyStatementStatus.PartiallySent => "warning",
        Domain.EMonthlyStatementStatus.Sent => "success",
        Domain.EMonthlyStatementStatus.Failed => "danger",
        _ => "neutral"
    };
}
<span class="badge badge--@tone">@Fmt.StatusLabel(Model)</span>
