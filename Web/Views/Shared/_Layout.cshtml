@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(params string[] controllers) => controllers.Contains(currentController) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="color-scheme" content="dark light"/>
    <title>@ViewData["Title"] - Invoice Service</title>
    <script>
        (() => {
            const storageKey = "invoice-service-theme";
            let theme = "dark";

            try {
                const savedTheme = localStorage.getItem(storageKey);
                const preferredLight = window.matchMedia?.("(prefers-color-scheme: light)").matches;
                theme = savedTheme || (preferredLight ? "light" : "dark");
            } catch {
                theme = "dark";
            }

            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@@400;500;600;700&family=JetBrains+Mono:wght@@400&display=swap"/>
    <partial name="_DesignSystem"/>
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true"/>
</head>
<body>
<partial name="_Icons"/>

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar__top">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand__mark" aria-hidden="true">IS</span>
                <span>Invoice Service</span>
            </a>
            <button class="icon-btn menu-button" type="button" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation" data-menu-toggle>
                <svg class="icon" aria-hidden="true"><use href="#i-menu"></use></svg>
            </button>
        </div>

        <nav class="nav" id="mainNavigation" aria-label="Main">
            <a class="nav-item" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@Current("Home")">
                <svg class="icon" aria-hidden="true"><use href="#i-home"></use></svg>Overview
            </a>

            <div class="nav__group">Billing</div>
            <a class="nav-item" asp-area="" asp-controller="Invoices" asp-action="Index" aria-current="@Current("Invoices", "InvoiceImports")">
                <svg class="icon" aria-hidden="true"><use href="#i-file-text"></use></svg>Invoices
            </a>
            <a class="nav-item" asp-area="" asp-controller="MonthlyStatements" asp-action="Index" aria-current="@Current("MonthlyStatements")">
                <svg class="icon" aria-hidden="true"><use href="#i-receipt"></use></svg>Statements
            </a>
            <a class="nav-item" asp-area="" asp-controller="InvoiceAllocations" asp-action="Index" aria-current="@Current("InvoiceAllocations")">
                <svg class="icon" aria-hidden="true"><use href="#i-split"></use></svg>Allocations
            </a>

            <div class="nav__group">Directory</div>
            <a class="nav-item" asp-area="" asp-controller="Addresses" asp-action="Index" aria-current="@Current("Addresses")">
                <svg class="icon" aria-hidden="true"><use href="#i-map-pin"></use></svg>Addresses
            </a>
            <a class="nav-item" asp-area="" asp-controller="Contacts" asp-action="Index" aria-current="@Current("Contacts")">
                <svg class="icon" aria-hidden="true"><use href="#i-users"></use></svg>Contacts
            </a>
            <a class="nav-item" asp-area="" asp-controller="AddressContacts" asp-action="Index" aria-current="@Current("AddressContacts")">
                <svg class="icon" aria-hidden="true"><use href="#i-link"></use></svg>Residents
            </a>
            <a class="nav-item" asp-area="" asp-controller="Services" asp-action="Index" aria-current="@Current("Services")">
                <svg class="icon" aria-hidden="true"><use href="#i-zap"></use></svg>Services
            </a>
        </nav>

        <div class="sidebar__spacer"></div>

        <div class="sidebar__footer">
            <button id="dsThemeToggle" class="switch" type="button" role="switch" aria-checked="true">
                <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
                <span>Dark mode</span>
            </button>
            <partial name="_LoginPartial"/>
        </div>
    </aside>

    <div class="main">
        <main role="main" class="content">
            @RenderBody()
        </main>

        @if (TempData["StatusMessage"] is string statusMessage)
        {
            var statusKind = TempData["StatusKind"] as string ?? "info";
            var statusIcon = statusKind switch { "success" => "i-circle-check", "danger" => "i-circle-x", "warning" => "i-triangle-alert", _ => "i-info" };
            <div class="toast-region">
                <div class="alert alert--@statusKind toast" role="@(statusKind is "danger" or "warning" ? "alert" : "status")" data-toast="@statusKind">
                    <svg class="icon" aria-hidden="true"><use href="#@statusIcon"></use></svg>
                    <div class="alert__body">@statusMessage</div>
                    <button type="button" class="icon-btn toast__close" aria-label="Dismiss" data-toast-close><svg class="icon icon--sm" aria-hidden="true"><use href="#i-x"></use></svg></button>
                </div>
            </div>
        }

        <footer class="app-footer">
            <span>&copy; Aleksander Laasmägi @DateTime.Now.Year</span>
            <span aria-hidden="true">/</span>
            <a href="https://alaasmagi.dev" target="_blank" rel="noopener noreferrer">Portfolio</a>
            <span aria-hidden="true">/</span>
            <a href="https://github.com/alaasmagi/invoice-service" target="_blank" rel="noopener noreferrer">Source</a>
            <span aria-hidden="true">/</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>
</div>

<script>
    (() => {
        const storageKey = "invoice-service-theme";
        const root = document.documentElement;
        const toggle = document.getElementById("dsThemeToggle");
        const sync = () => toggle.setAttribute("aria-checked", String(root.getAttribute("data-theme") === "dark"));
        toggle.addEventListener("click", () => {
            const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
            root.setAttribute("data-theme", next);
            root.setAttribute("data-bs-theme", next);
            try { localStorage.setItem(storageKey, next); } catch { /* storage unavailable */ }
            sync();
        });
        sync();

        const sidebar = document.getElementById("sidebar");
        const menu = document.querySelector("[data-menu-toggle]");
        menu.addEventListener("click", () => {
            const open = sidebar.classList.toggle("is-open");
            menu.setAttribute("aria-expanded", String(open));
        });
    })();
</script>
<dialog id="confirmDialog" class="dialog" aria-labelledby="confirmDialogTitle">
    <form method="dialog" class="dialog__body">
        <div class="dialog__header">
            <h2 id="confirmDialogTitle" class="dialog__title" data-confirm-title>Are you sure?</h2>
            <button type="submit" value="cancel" class="icon-btn" aria-label="Close"><svg class="icon" aria-hidden="true"><use href="#i-x"></use></svg></button>
        </div>
        <p class="dialog__message" data-confirm-message></p>
        <div class="dialog__actions">
            <button type="submit" value="cancel" class="btn btn--ghost" autofocus>Cancel</button>
            <button type="submit" value="ok" class="btn btn--primary" data-confirm-ok>Confirm</button>
        </div>
    </form>
</dialog>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
