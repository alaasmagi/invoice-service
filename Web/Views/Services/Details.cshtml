@model ServiceDto
@{
    ViewData["Title"] = Model.Name;
    var invoiceCount = ViewData["InvoiceCount"] as int? ?? 0;
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Service"]</p>
        <h1>@Model.Name</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg>@T["Edit"]</a>
    </div>
</header>

<div class="section medium">
    <dl class="card details">
        <div class="details__row"><dt>@T["Name"]</dt><dd>@Model.Name</dd></div>
        <div class="details__row"><dt>@T["Invoices"]</dt><dd><a asp-controller="Invoices" asp-action="Index" asp-route-serviceId="@Model.Id" class="link">@T.Plural(invoiceCount, "{0} invoice", "{0} invoices")</a></dd></div>
    </dl>
    <div><a asp-action="Index" class="btn btn--ghost">@T["Back to services"]</a></div>
</div>
