@model ServiceDto
@{
    ViewData["Title"] = T["Edit service"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Edit service"]</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field">
        <label asp-for="Name" class="field__label"></label>
        <input asp-for="Name" class="input" placeholder="@T["e.g. Enefit electricity"]" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save changes"]</button>
        <a asp-action="Index" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
