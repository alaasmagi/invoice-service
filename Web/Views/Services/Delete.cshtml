@model DTO.DataAccess.DataAccess.DTO.ServiceEntity
@{
    ViewData["Title"] = "Delete service";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Directory</p>
        <h1>Delete service</h1>
    </div>
</header>

<div class="section medium">
    <div class="alert alert--danger" role="alert">
        <svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg>
        <div class="alert__body"><span class="alert__title">Delete this service?</span><span>This action cannot be undone.</span></div>
    </div>
    <dl class="card details">
    <div class="details__row"><dt>Name</dt><dd>@Model.Name</dd></div>
</dl>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn--danger">Delete service</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </form>
</div>
