@model OverviewViewModel
@{
    var o = Model.Overview;
    var period = o.Period;
    ViewData["Title"] = T["Overview"];
    var attention = o.FailedCount + o.InvoicesWithoutResidents.Count + o.MissingInvoices.Count;
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Overview"]</p>
        <h1>@period.Label</h1>
    </div>
    <form method="get" asp-action="Index" class="page-header__actions" aria-label="@T["Choose month"]">
        <div class="field">
            <label for="overviewPeriod" class="visually-hidden">@T["Month"]</label>
            <div class="field__control">
                <select id="overviewPeriod" name="period" class="input" data-autosubmit>
                    @foreach (var option in Model.PeriodOptions)
                    {
                        <option value="@option.Key" selected="@(option == period)">@option.Label</option>
                    }
                </select>
                <svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg>
            </div>
        </div>
        <noscript><button type="submit" class="btn btn--secondary">@T["Show"]</button></noscript>
    </form>
</header>

@* ----- The one thing to do next ----- *@
@if (!Model.SetupComplete)
{
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@T["Finish setting up"]</h2>
            <p>@T["Statements are built from invoices, split between the residents of each address. Add these once and you're ready for monthly billing."]</p>
        </div>
    </section>
}
else if (!o.Invoices.Any())
{
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@T["Add invoices for {0}", period.Label]</h2>
            <p>@T["Enter invoices manually or import Telia and Enefit PDFs."]@(o.MissingInvoices.Any() ? " " + T.Plural(o.MissingInvoices.Count, "Last month you had {0} recurring invoice.", "Last month you had {0} recurring invoices.") : "")</p>
        </div>
        <div class="actions">
            <a asp-controller="InvoiceImports" asp-action="Upload" class="btn btn--secondary"><svg class="icon" aria-hidden="true"><use href="#i-upload"></use></svg>@T["Import PDF"]</a>
            <a asp-controller="Invoices" asp-action="Create" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>@T["Add invoice"]</a>
        </div>
    </section>
}
else if (o.NeedsGeneration)
{
    var regenerate = o.Statements.Any();
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@(regenerate ? T["Update statements for {0}", period.Label] : T["Generate statements for {0}", period.Label])</h2>
            <p>@(regenerate
                   ? T.Plural(o.PendingInvoiceCount, "{0} invoice changed since the statements were generated.", "{0} invoices changed since the statements were generated.")
                   : T.Plural(o.AllocatableInvoiceCount, "{0} invoice totalling {1} is ready to be split between residents.", "{0} invoices totalling {1} are ready to be split between residents.", Fmt.Money(o.InvoiceTotal)))
               @(o.MissingInvoices.Any() ? T.Plural(o.MissingInvoices.Count, "Check the {0} invoice that may still be missing first.", "Check the {0} invoices that may still be missing first.") : "")</p>
        </div>
        <form asp-controller="MonthlyStatements" asp-action="Generate" method="post"
              data-confirm="@(o.SentCount > 0 ? T.Plural(o.SentCount, "{0} statement for {1} was already sent. Regenerating marks every statement for the month as \"Ready to send\" again.", "{0} statements for {1} were already sent. Regenerating marks every statement for the month as \"Ready to send\" again.", period.Label).Value : null)"
              data-confirm-title="@T["Regenerate {0}?", period.Label]" data-confirm-action="@T["Regenerate"]" data-confirm-tone="danger">
            <input type="hidden" name="year" value="@period.Year" />
            <input type="hidden" name="month" value="@period.Month" />
            <button type="submit" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-refresh"></use></svg>@(regenerate ? T["Regenerate"] : T["Generate statements"])</button>
        </form>
    </section>
}
else if (o.FailedCount > 0)
{
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@T.Plural(o.FailedCount, "{0} statement failed to send", "{0} statements failed to send")</h2>
            <p>@T["Check the recipients' email addresses and send them again."]</p>
        </div>
        <a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" asp-route-status="Failed" class="btn btn--primary">@T["Review failed"]</a>
    </section>
}
else if (o.UnsentCount > 0)
{
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@T.Plural(o.UnsentCount, "Send {0} statement", "Send {0} statements")</h2>
            <p>@T["{0} in total for {1}.", Fmt.Money(o.UnsentTotal), period.Label] <a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" class="link">@T["Review them first"]</a></p>
        </div>
        <form asp-controller="MonthlyStatements" asp-action="SendPeriod" method="post"
              data-confirm="@T.Plural(o.UnsentCount, "{0} statement totalling {1} will be emailed to the recipient. Already sent statements are skipped.", "{0} statements totalling {1} will be emailed to the recipients. Already sent statements are skipped.", Fmt.Money(o.UnsentTotal))"
              data-confirm-title="@T["Send {0} statements?", period.Label]" data-confirm-action="@T["Send {0}", o.UnsentCount]">
            <input type="hidden" name="year" value="@period.Year" />
            <input type="hidden" name="month" value="@period.Month" />
            <button type="submit" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg>@T["Send all"]</button>
        </form>
    </section>
}
else if (o.AllSent)
{
    <section class="card next-step next-step--done">
        <div class="next-step__copy">
            <span class="kicker">@T["All done"]</span>
            <h2 class="next-step__title">@T["Every {0} statement has been sent", period.Label]</h2>
            <p>@T.Plural(o.SentCount, "{0} statement, {1} in total.", "{0} statements, {1} in total.", Fmt.Money(o.StatementTotal))</p>
        </div>
        <a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" class="btn btn--secondary">@T["View statements"]</a>
    </section>
}
else
{
    <section class="card next-step">
        <div class="next-step__copy">
            <span class="kicker">@T["Next step"]</span>
            <h2 class="next-step__title">@T["Add residents to bill"]</h2>
            <p>@T["None of this month's invoices can be split yet, because nobody lived at their addresses on the invoice dates."]</p>
        </div>
        <a asp-controller="AddressContacts" asp-action="Create" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>@T["Add resident"]</a>
    </section>
}

<section class="stat-grid" aria-label="@period.Label at a glance">
    <a asp-controller="Invoices" asp-action="Index" asp-route-period="@period.Key" class="card stat">
        <span class="stat__label">@T["Invoices"]</span>
        <span class="stat__value">@o.Invoices.Count</span>
        <span class="stat__hint">@Fmt.Money(o.InvoiceTotal)</span>
    </a>
    <a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" class="card stat">
        <span class="stat__label">@T["Statements"]</span>
        <span class="stat__value">@o.Statements.Count</span>
        <span class="stat__hint">@Fmt.Money(o.StatementTotal)</span>
    </a>
    <a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" class="card stat">
        <span class="stat__label">@T["Sent"]</span>
        <span class="stat__value">@o.SentCount<span class="secondary"> / @o.Statements.Count</span></span>
        <span class="stat__hint">@(o.UnsentCount > 0 ? T["{0} waiting", o.UnsentCount] : o.Statements.Any() ? T["Nothing waiting"] : T["No statements yet"])</span>
    </a>
    <div class="card stat">
        <span class="stat__label">@T["Needs attention"]</span>
        <span class="stat__value">@attention</span>
        <span class="stat__hint">@(attention == 0 ? T["All clear"] : T["See checklist below"])</span>
    </div>
</section>

<div class="overview-grid">
    <section class="section">
        <div class="section-head">
            <h2 class="section-title">@T["Invoices in {0}", period.Label]</h2>
            <a asp-controller="Invoices" asp-action="Create" class="btn btn--ghost btn--sm"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>@T["Add invoice"]</a>
        </div>
        <div class="card table-card">
            <table class="data-table">
                <thead><tr><th>@T["Date"]</th><th>@T["Address"]</th><th>@T["Service"]</th><th class="num">@T["Total"]</th></tr></thead>
                <tbody>
                @foreach (var invoice in o.Invoices.Take(8))
                {
                    <tr class="@(o.InvoicesWithoutResidents.Any(e => e.Id == invoice.Id) ? "is-warning" : null)">
                        <td class="nowrap"><a asp-controller="Invoices" asp-action="Details" asp-route-id="@invoice.Id" class="link">@Fmt.Date(invoice.InvoiceDate)</a></td>
                        <td>@invoice.Address.Name</td>
                        <td>@invoice.Service.Name</td>
                        <td class="num">@Fmt.Money(invoice.TotalSum)</td>
                    </tr>
                }
                @if (!o.Invoices.Any())
                {
                    <tr><td colspan="4" class="empty">@T["No invoices for {0} yet.", period.Label]</td></tr>
                }
                </tbody>
            </table>
        </div>
        @if (o.Invoices.Count > 8)
        {
            <a asp-controller="Invoices" asp-action="Index" asp-route-period="@period.Key" class="link">@T["View all {0} invoices", o.Invoices.Count]</a>
        }
    </section>

    <section class="section">
        <h2 class="section-title">@T["Checklist"]</h2>
        <ul class="card checklist">
            @if (!Model.SetupComplete)
            {
                <li class="@(Model.HasAddresses ? "is-done" : null)"><svg class="icon" aria-hidden="true"><use href="#@(Model.HasAddresses ? "i-circle-check" : "i-circle")"></use></svg><span class="checklist__text"><a asp-controller="Addresses" asp-action="Create" class="link">@T["Add an address"]</a><span>@T["The homes or locations that receive invoices."]</span></span></li>
                <li class="@(Model.HasServices ? "is-done" : null)"><svg class="icon" aria-hidden="true"><use href="#@(Model.HasServices ? "i-circle-check" : "i-circle")"></use></svg><span class="checklist__text"><a asp-controller="Services" asp-action="Create" class="link">@T["Add a service"]</a><span>@T["e.g. electricity, internet, water."]</span></span></li>
                <li class="@(Model.HasContacts ? "is-done" : null)"><svg class="icon" aria-hidden="true"><use href="#@(Model.HasContacts ? "i-circle-check" : "i-circle")"></use></svg><span class="checklist__text"><a asp-controller="Contacts" asp-action="Create" class="link">@T["Add a contact"]</a><span>@T["People who receive statements."]</span></span></li>
                <li class="@(Model.HasResidents ? "is-done" : null)"><svg class="icon" aria-hidden="true"><use href="#@(Model.HasResidents ? "i-circle-check" : "i-circle")"></use></svg><span class="checklist__text"><a asp-controller="AddressContacts" asp-action="Create" class="link">@T["Link residents to addresses"]</a><span>@T["Decides who shares each invoice."]</span></span></li>
            }
            @foreach (var missing in o.MissingInvoices)
            {
                <li class="is-warning"><svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg><span class="checklist__text"><a asp-controller="Invoices" asp-action="Create" asp-route-addressId="@missing.Address.Id" asp-route-serviceId="@missing.Service.Id" class="link">@missing.Service.Name · @missing.Address.Name</a><span>@T["Billed in {0} but not yet in {1}.", period.Previous.Label, period.Label]</span></span></li>
            }
            @foreach (var invoice in o.InvoicesWithoutResidents)
            {
                <li class="is-warning"><svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg><span class="checklist__text"><a asp-controller="Addresses" asp-action="Details" asp-route-id="@invoice.AddressId" class="link">@T["No residents at {0}", invoice.Address.Name]</a><span>@T["{0} ({1}) won't be billed to anyone.", invoice.Service.Name, Fmt.Date(invoice.InvoiceDate)]</span></span></li>
            }
            @if (o.FailedCount > 0)
            {
                <li class="is-warning"><svg class="icon" aria-hidden="true"><use href="#i-triangle-alert"></use></svg><span class="checklist__text"><a asp-controller="MonthlyStatements" asp-action="Index" asp-route-period="@period.Key" asp-route-status="Failed" class="link">@T.Plural(o.FailedCount, "{0} failed statement", "{0} failed statements")</a><span>@T["Sending didn't go through."]</span></span></li>
            }
            @if (Model.SetupComplete && attention == 0)
            {
                <li class="is-done"><svg class="icon" aria-hidden="true"><use href="#i-circle-check"></use></svg><span class="checklist__text"><span>@T["Nothing needs attention"]</span><span>@T["Every recurring invoice is in and every invoice has someone to bill."]</span></span></li>
            }
        </ul>
    </section>
</div>
