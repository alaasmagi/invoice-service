@model IEnumerable<DTO.DataAccess.DataAccess.DTO.InvoiceAllocationEntity>
@{
    ViewData["Title"] = "Invoice allocations";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Billing</p>
        <h1>Invoice allocations</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Create" class="btn btn--primary"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>Create allocation</a>
    </div>
</header>

<div class="card table-card">
    <table class="data-table">
        <thead><tr><th>Invoice</th><th>Contact</th><th class="num">Amount</th><th class="actions-col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><div class="stack-cell"><span>@item.Invoice.InvoiceDate</span><span>@item.Invoice.Address.Name</span></div></td>
                <td>@item.Contact.FullName</td>
                <td class="num">@item.AllocatedSum €</td>
                <td class="actions-col"><div class="row-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="icon-btn" aria-label="Details" title="Details"><svg class="icon" aria-hidden="true"><use href="#i-eye"></use></svg></a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="icon-btn" aria-label="Edit" title="Edit"><svg class="icon" aria-hidden="true"><use href="#i-pencil"></use></svg></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="icon-btn icon-btn--danger" aria-label="Delete" title="Delete"><svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg></a>
                </div></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="empty">No allocations yet.</td></tr>
        }
        </tbody>
    </table>
</div>
