@model DTO.DataAccess.DataAccess.DTO.AddressContactEntity
@{
    ViewData["Title"] = "Edit address contact";
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">Directory</p>
        <h1>Edit address contact</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-row">
        <div class="field">
            <label asp-for="AddressId" class="field__label"></label>
            <div class="field__control"><select asp-for="AddressId" class="input" asp-items="ViewBag.AddressId"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="AddressId"></span>
        </div>
        <div class="field">
            <label asp-for="ContactId" class="field__label"></label>
            <div class="field__control"><select asp-for="ContactId" class="input" asp-items="ViewBag.ContactId"></select><svg class="icon icon--end" aria-hidden="true"><use href="#i-chevron-down"></use></svg></div>
            <span asp-validation-for="ContactId"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="field">
            <label asp-for="StartDate" class="field__label"></label>
            <div class="field__control has-icon"><svg class="icon" aria-hidden="true"><use href="#i-calendar"></use></svg><input asp-for="StartDate" class="input" type="date" /></div>
            <span asp-validation-for="StartDate"></span>
        </div>
        <div class="field">
            <label asp-for="EndDate" class="field__label"></label>
            <div class="field__control has-icon"><svg class="icon" aria-hidden="true"><use href="#i-calendar"></use></svg><input asp-for="EndDate" class="input" type="date" /></div>
            <span asp-validation-for="EndDate"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">Save</button>
        <a asp-action="Index" class="btn btn--ghost">Cancel</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
