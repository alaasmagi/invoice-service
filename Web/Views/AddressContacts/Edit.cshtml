@model AddressContactDto
@{
    ViewData["Title"] = T["Edit resident"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Edit resident"]</h1>
    </div>
</header>

<form asp-action="Edit" method="post" class="card form narrow">
    <input type="hidden" asp-for="Id" />
    <partial name="_ResidentFields" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save changes"]</button>
        <a href="@Url.LocalOr(ViewData["ReturnUrl"] as string, Url.Action("Index"))" class="btn btn--ghost">@T["Cancel"]</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn--ghost" style="margin-left:auto">@T["Remove"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
