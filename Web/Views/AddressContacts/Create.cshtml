@model AddressContactDto
@{
    ViewData["Title"] = T["Add resident"];
}

<header class="page-header">
    <div class="page-header__title">
        <p class="kicker">@T["Directory"]</p>
        <h1>@T["Add resident"]</h1>
        <p class="page-header__lede">@T["Link a person to an address. Invoices are shared between everyone living there on the invoice date, equally unless a split rule says otherwise."]</p>
    </div>
</header>

<form asp-action="Create" method="post" class="card form narrow">
    <partial name="_ResidentFields" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn--primary">@T["Save resident"]</button>
        <a href="@Url.LocalOr(ViewData["ReturnUrl"] as string, Url.Action("Index"))" class="btn btn--ghost">@T["Cancel"]</a>
    </div>
</form>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
