# Copy this file to .env for local development and fill in real values.

# Application HTTP port inside container/process (used to build ASPNETCORE_URLS when not set explicitly).
APP_PORT=8080

# Optional host port mapping for docker compose deployments.
HOST_PORT=8080

# PostgreSQL connection used by AppDbContext.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=invoice_app;Username=invoice_user;Password=change-me;Search Path=invoice

# RabbitMQ connection and routing. Credentials come from the URI only; this service's broker user
# has topic-write permission on ^invoice\. on email-hub.commands and read on its own queue.
RABBITMQ_URI=amqps://invoice:password@rabbitmq.example.com:5671/vhost
# Exchange invoice mail is published to (email-hub.commands). Topology is created on the broker;
# this service never declares it.
RABBITMQ_EXCHANGE=email-hub.commands
# Pre-declared consumer queue for identity-hub user events (bound to identity-hub.invoice.#).
RABBITMQ_QUEUE=invoice.users

# Glitchtip/Sentry-compatible error and log reporting.
GLITCHTIP_DSN=https://examplePublicKey@glitchtip.example.com/1
GLITCHTIP_RELEASE=invoice-service

# Keycloak authentication.
KEYCLOAK_AUTHORITY=https://identity.alaasmagi.dev/realms/invoice-service
KEYCLOAK_CLIENT_ID=invoice-service
KEYCLOAK_CLIENT_SECRET=change-me
