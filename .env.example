# Copy this file to .env for local development and fill in real values.

# Application HTTP port inside container/process (used to build ASPNETCORE_URLS when not set explicitly).
APP_PORT=8080

# Optional host port mapping for docker compose deployments.
HOST_PORT=8080

# PostgreSQL connection used by AppDbContext.
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=invoice_app;Username=invoice_user;Password=change-me;Search Path=invoice

# RabbitMQ connection and routing. Credentials come from the URI only. Topology (exchanges, queues,
# bindings, permissions) is created on the broker; this service never declares it.
RABBITMQ_URI=amqps://invoice:password@rabbitmq.example.com:5671/vhost
# This service's own pre-declared consumer queue, bound to identity-hub.events (identity-hub.invoice-service.#)
# and ai-hub.events (ai-hub.invoice-service.#).
RABBITMQ_QUEUE=invoice-service
# Exchange invoice mail is published to.
RABBITMQ_NOTIFICATION_HUB_EXCHANGE=notification-hub.commands
# Exchange ai-hub commands are published to.
RABBITMQ_AI_HUB_EXCHANGE=ai-hub.commands

# Glitchtip/Sentry-compatible error and log reporting.
GLITCHTIP_DSN=https://examplePublicKey@glitchtip.example.com/1
GLITCHTIP_RELEASE=invoice-service

# Keycloak authentication.
KEYCLOAK_AUTHORITY=https://identity.alaasmagi.dev/realms/invoice-service
KEYCLOAK_CLIENT_ID=invoice-service
KEYCLOAK_CLIENT_SECRET=change-me

# Cloudflare R2 (S3-compatible) object storage for invoice PDFs. The bucket is private; files are
# served through short-lived signed URLs.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_BUCKET_NAME=invoice-service
